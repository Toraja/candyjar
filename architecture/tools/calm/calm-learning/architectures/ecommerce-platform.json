{
    "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
    "unique-id": "ecommerce-order-processing-platform",
    "name": "E-Commerce Order Processing Platform",
    "description": "E-commerce order processing platform",
    "metadata": {
        "owner": "architect@company.com",
        "version": "1.0.0",
        "created": "2026-07-09",
        "description": "E-commerce order processing platform",
        "tags": ["ecommerce", "microservices", "orders"]
    },
    "nodes": [
        {
            "unique-id": "customer",
            "node-type": "actor",
            "name": "Customer",
            "description": "An end user who browses products, places orders, and tracks fulfilment on the e-commerce platform"
        },
        {
            "unique-id": "admin",
            "node-type": "actor",
            "name": "Admin",
            "description": "An internal operations user who manages products, inventory levels, and order fulfilment via the platform"
        },
        {
            "unique-id": "api-gateway",
            "node-type": "service",
            "name": "API Gateway",
            "description": "Single entry point for all client requests; handles authentication, rate limiting, and routing to downstream microservices",
            "metadata": {
                "owner": "architect@company.com",
                "repository": "https://github.com/example-org/ecommerce-api-gateway",
                "deployment-type": "container",
                "sla-tier": "tier-1"
            },
            "interfaces": [
                {
                    "unique-id": "api-gateway-https",
                    "protocol": "HTTPS",
                    "host": "api.example-store.com",
                    "port": 443,
                    "path": "/api/v1"
                }
            ]
        },
        {
            "unique-id": "order-service",
            "node-type": "service",
            "name": "Order Service",
            "description": "Manages the full order lifecycle: creation, status tracking, updates, and cancellation; coordinates with the Inventory and Payment services",
            "metadata": {
                "owner": "architect@company.com",
                "repository": "https://github.com/example-org/ecommerce-order-service",
                "deployment-type": "container",
                "sla-tier": "tier-1"
            },
            "interfaces": [
                {
                    "unique-id": "order-service-api",
                    "protocol": "HTTP",
                    "host": "order-service.internal",
                    "port": 8080,
                    "path": "/orders"
                }
            ]
        },
        {
            "unique-id": "inventory-service",
            "node-type": "service",
            "name": "Inventory Service",
            "description": "Tracks product stock levels, reserves inventory when an order is placed, and releases reservations on cancellation or fulfilment",
            "metadata": {
                "owner": "architect@company.com",
                "repository": "https://github.com/example-org/ecommerce-inventory-service",
                "deployment-type": "container",
                "sla-tier": "tier-1"
            },
            "interfaces": [
                {
                    "unique-id": "inventory-service-api",
                    "protocol": "HTTP",
                    "host": "inventory-service.internal",
                    "port": 8081,
                    "path": "/inventory"
                }
            ]
        },
        {
            "unique-id": "payment-service",
            "node-type": "service",
            "name": "Payment Service",
            "description": "Processes payment authorisation, capture, and refunds by integrating with external payment providers; enforces PCI-DSS controls",
            "metadata": {
                "owner": "architect@company.com",
                "repository": "https://github.com/example-org/ecommerce-payment-service",
                "deployment-type": "container",
                "sla-tier": "tier-1",
                "compliance": "PCI-DSS"
            },
            "interfaces": [
                {
                    "unique-id": "payment-service-api",
                    "protocol": "HTTPS",
                    "host": "payment-service.internal",
                    "port": 8443,
                    "path": "/payments"
                }
            ]
        },
        {
            "unique-id": "order-database",
            "node-type": "database",
            "name": "Order Database",
            "description": "PostgreSQL database storing order records, line items, and order status history for the Order Service",
            "metadata": {
                "owner": "architect@company.com",
                "deployment-type": "managed",
                "engine": "PostgreSQL 15"
            },
            "interfaces": [
                {
                    "unique-id": "order-db-connection",
                    "host": "order-db.internal",
                    "port": 5432,
                    "database": "orders"
                }
            ]
        },
        {
            "unique-id": "inventory-database",
            "node-type": "database",
            "name": "Inventory Database",
            "description": "PostgreSQL database storing product catalogue, stock levels, and inventory reservation records for the Inventory Service",
            "metadata": {
                "owner": "architect@company.com",
                "deployment-type": "managed",
                "engine": "PostgreSQL 15"
            },
            "interfaces": [
                {
                    "unique-id": "inventory-db-connection",
                    "host": "inventory-db.internal",
                    "port": 5432,
                    "database": "inventory"
                }
            ]
        },
        {
            "unique-id": "ecommerce-platform",
            "node-type": "system",
            "name": "E-Commerce Platform",
            "description": "The complete e-commerce order processing system, encompassing the API gateway, all microservices, and their backing data stores"
        }
    ],
    "relationships": [
        {
            "unique-id": "customer-interacts-with-platform",
            "description": "Browses products, places orders, and tracks fulfilment via",
            "relationship-type": {
                "interacts": {
                    "actor": "customer",
                    "nodes": ["api-gateway"]
                }
            }
        },
        {
            "unique-id": "admin-interacts-with-platform",
            "description": "Manages products, inventory levels, and order operations via",
            "relationship-type": {
                "interacts": {
                    "actor": "admin",
                    "nodes": ["api-gateway"]
                }
            }
        },
        {
            "unique-id": "api-gateway-to-order-service",
            "description": "Routes order-related requests to",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "api-gateway",
                        "interfaces": ["api-gateway-https"]
                    },
                    "destination": {
                        "node": "order-service",
                        "interfaces": ["order-service-api"]
                    }
                }
            },
            "protocol": "HTTPS",
            "metadata": {
                "latency-sla": "< 200ms p95",
                "monitoring": true,
                "circuit-breaker": true,
                "retry-policy": "3 attempts with exponential backoff"
            }
        },
        {
            "unique-id": "api-gateway-to-inventory-service",
            "description": "Routes inventory and product-browsing requests to",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "api-gateway",
                        "interfaces": ["api-gateway-https"]
                    },
                    "destination": {
                        "node": "inventory-service",
                        "interfaces": ["inventory-service-api"]
                    }
                }
            },
            "protocol": "HTTPS",
            "metadata": {
                "latency-sla": "< 100ms p95",
                "monitoring": true,
                "circuit-breaker": true,
                "cache-ttl": "60s"
            }
        },
        {
            "unique-id": "order-service-to-payment-service",
            "description": "Initiates payment authorisation and capture by sending requests to",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "order-service",
                        "interfaces": ["order-service-api"]
                    },
                    "destination": {
                        "node": "payment-service",
                        "interfaces": ["payment-service-api"]
                    }
                }
            },
            "protocol": "HTTPS",
            "metadata": {
                "latency-sla": "< 500ms p95",
                "monitoring": true,
                "circuit-breaker": true,
                "timeout": "10s",
                "idempotency": "required"
            }
        },
        {
            "unique-id": "order-service-to-order-database",
            "description": "Reads and writes order records and status history to",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "order-service",
                        "interfaces": ["order-service-api"]
                    },
                    "destination": {
                        "node": "order-database",
                        "interfaces": ["order-db-connection"]
                    }
                }
            },
            "protocol": "JDBC",
            "metadata": {
                "latency-sla": "< 20ms p95",
                "monitoring": true,
                "connection-pool-size": 20,
                "ssl-enabled": true
            }
        },
        {
            "unique-id": "inventory-service-to-inventory-database",
            "description": "Reads and writes product stock levels and reservation records to",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "inventory-service",
                        "interfaces": ["inventory-service-api"]
                    },
                    "destination": {
                        "node": "inventory-database",
                        "interfaces": ["inventory-db-connection"]
                    }
                }
            },
            "protocol": "JDBC",
            "metadata": {
                "latency-sla": "< 20ms p95",
                "monitoring": true,
                "connection-pool-size": 15,
                "ssl-enabled": true
            }
        },
        {
            "unique-id": "ecommerce-platform-composed-of",
            "description": "Is composed of the API gateway, all microservices, and their backing databases",
            "relationship-type": {
                "composed-of": {
                    "container": "ecommerce-platform",
                    "nodes": [
                        "api-gateway",
                        "order-service",
                        "inventory-service",
                        "payment-service",
                        "order-database",
                        "inventory-database"
                    ]
                }
            }
        }
    ]
}
